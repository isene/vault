#!/bin/sh
# vault-pop: open vault in a glass of its own. Ctrl+Enter there copies
# the password, closes vault, and pastes into the window that had focus
# before. The paste runs here, after glass has closed. vault leaves a
# flag file on Ctrl+Enter; yank sends the one Shift+Insert.
hex=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | grep -oE '0x[0-9a-f]+' | head -1)
target=$(( ${hex:-0} ))
flag="${XDG_RUNTIME_DIR:-/tmp}/vault-paste"
rm -f "$flag"
glass --class Vault -- "$HOME/bin/vault"
if [ -e "$flag" ] && [ "$target" -gt 1 ]; then
    rm -f "$flag"
    exec "$HOME/bin/yank" --paste-into "$target"
fi
